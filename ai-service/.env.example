HD_QUALITY=95
JPEG_DPI=300

BLUR_THRESHOLD=30.0
MIN_IMAGE_WIDTH=400
MIN_IMAGE_HEIGHT=400
MIN_FACE_WIDTH=60
MIN_FACE_HEIGHT=60
MIN_FACE_AREA_RATIO=0.08
MIN_FACE_HEIGHT_RATIO=0.20
MAX_FACE_CENTER_OFFSET_RATIO=0.18
MIN_FACE_ASPECT_RATIO=0.65
MAX_FACE_ASPECT_RATIO=1.35
OCCLUDED_FACE_ASPECT_RATIO=0.55
EDGE_TOUCH_RATIO=0.03
MIN_VALID_FACE_WIDTH=60
MIN_VALID_FACE_HEIGHT=60
MULTI_FACE_MIN_AREA_RATIO=0.25
FACE_BOX_IOU_THRESHOLD=0.35
