APP_NAME=ai-id-photo-service
APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

UPLOAD_ROOT=uploads
UPLOAD_PUBLIC_PREFIX=uploads
ORIGINAL_DIR=original
PREVIEW_DIR=preview
HD_DIR=hd
PRINT_DIR=print
TEMP_DIR=temp
MAX_UPLOAD_MB=15
DEFAULT_BG_COLOR=white
DEFAULT_LAYOUT_TYPE=six
SAVE_INTERMEDIATE=true

MIN_IMAGE_WIDTH=295
MIN_IMAGE_HEIGHT=413
BLUR_SCORE_THRESHOLD=0.35
SEGMENTATION_ENABLED=false
PREVIEW_QUALITY=88
HD_QUALITY=95
JPEG_DPI=300
