APP_NAME=ai-id-photo-service
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Shared uploads mount in container (mapped from host by docker-compose)
UPLOAD_BASE_DIR=/data/uploads
# Returned URL prefix for server DB/path conventions
UPLOAD_PUBLIC_PREFIX=uploads

PREVIEW_QUALITY=88
HD_QUALITY=95
JPEG_DPI=300
