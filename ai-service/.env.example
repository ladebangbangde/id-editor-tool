APP_NAME=ai-id-photo-service
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
UPLOAD_ROOT=uploads
ORIGINAL_DIR=original
PREVIEW_DIR=preview
HD_DIR=hd
PRINT_DIR=print
TEMP_DIR=temp
MAX_UPLOAD_MB=15
DEFAULT_BG_COLOR=white
DEFAULT_LAYOUT_TYPE=six
SAVE_INTERMEDIATE=true
