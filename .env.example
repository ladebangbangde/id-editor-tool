SERVICE_NAME=id-editor-tool
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEBUG=false
UPLOAD_ROOT=/app/uploads
STATIC_MOUNT_PATH=/uploads
ORIGINAL_DIR=original
PREVIEW_DIR=preview
HD_DIR=hd
PRINT_DIR=print
TEMP_DIR=temp
SAVE_INTERMEDIATE=true
ENABLE_WINK_HARD_FAIL=false
ENABLE_FOREGROUND_DECONTAMINATION=false
ENABLE_CLOTH_POLLUTION_CHECK=true
ENABLE_DECONTAMINATED_OUTPUT_AS_DEFAULT=false
MAX_UPLOAD_SIZE_MB=15
DEFAULT_BACKGROUND_COLOR=blue
DEFAULT_SIZE_KEY=one_inch
DEFAULT_LAYOUT_PAPER=6inch
MIN_IMAGE_WIDTH=400
MIN_IMAGE_HEIGHT=400
PREVIEW_QUALITY=90
HD_QUALITY=95

PHOTO_ENGINE=auto
ENABLE_HIVISION_COMPARISON=true
ENABLE_HIVISION_AS_DEFAULT=false
HIVISION_REPO_PATH=
